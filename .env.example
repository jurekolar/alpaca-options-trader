# Copy this file to .env and fill in your local Alpaca credentials.
# .env is ignored by git.

# Paper account credentials used by scan, research-universe, paper-trade, and backtest.
ALPACA_PAPER_API_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Live account credentials used only by live-trade, close-position --live, and status --live.
ALPACA_LIVE_API_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# Keep false unless Alpaca explicitly tells you to use the sandbox data API.
ALPACA_PAPER_SANDBOX=false
ALPACA_LIVE_SANDBOX=false

# Optional live-trading safety gate. Leave false until you intentionally enable live mode.
ALLOW_LIVE_TRADING=false
